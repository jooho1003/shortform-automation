# 파이썬
pipeline/.venv/
pipeline/.venv-tts/
pipeline/data/tts/
pipeline/data/voices/
**/.tts.lock
**/.tts-stage-*/
**/.tts-previous-*/
__pycache__/
*.pyc

# 노드 / Remotion
pipeline/remotion/node_modules/
pipeline/remotion/public/ep/
pipeline/remotion/props.json
pipeline/remotion/out/

# 비밀. 절대 올리지 않는다
pipeline/secrets/
.env
*.pem
client_secret*.json
*token*.json

# 내려받은 원본과 캐시. 편당 수십 MB
pipeline/data/cache/

# 편 산출물 중 미디어. 기획안·승인 파일·컨택트시트·클립목록은 올린다
2026-*/*/03-소재/
2026-*/*/04-영상/
2026-*/*/02-이미지/프레임/
2026-*/*/상태.json

# 토큰 절약용 축소본
*-sm.png
*-sm.jpg

# 이 레포와 무관한 기존 자산
shortform-skill/
귀칼실사화/
레퍼런스 이미지/
.bkit/
2026-09-08 10 43 03_002*.png

# web console (Next.js) / npm workspace
pipeline/node_modules/
pipeline/web/node_modules/
pipeline/web/.next/
pipeline/web/next-env.d.ts
pipeline/data/logs/
pipeline/data/jobs/

# 릴스 기획·A안 산출물 중 미디어와 로그. 기획안·분석·컨택트시트·검사 결과는 올린다
릴스기획/*/원본.*
릴스기획/*/프레임/
2026-*/*/02-이미지/시트.png
2026-*/*/02-이미지/키프레임-*.png
**/로그/
pipeline/data/tmp/

# 계정별 게시 이력과 SQLite 실행 파일
pipeline/data/publishing.sqlite3*

# 블로그 생성 미디어·복사 패키지 (기획 JSON·본문·점검은 보존)
블로그/*/이미지/*.png
블로그/*/이미지/*.jpg
블로그/*/이미지/*.jpeg
블로그/*/이미지/*.webp
블로그/*/게시패키지/

# 내려받은 실행 파일 (cloudflared 등)
pipeline/data/tools/

# 게시 업로드용 미디어 캐시. 해시 파일명, 편당 수십 MB
pipeline/data/buffer-media/

# C안 모션 샘플 미디어. 렌더 시 재생성
pipeline/remotion/public/c-motion/

# 카드뉴스·인스타툰 생성 미디어. 프로젝트.json만 올린다
카드뉴스/*/출력/
인스타툰/*/출력/
인스타툰/*/컷/
인스타툰/*/캐릭터/

# 옵시디언 작업 공간
.obsidian/
